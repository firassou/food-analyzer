# Copy to .env.local and fill in. Never commit real keys.

# Hugging Face router key (primary provider). Required unless NVIDIA_API_KEY is set.
HF_TOKEN=

# Optional second provider (NVIDIA NIM, OpenAI-compatible).
NVIDIA_API_KEY=

# Optional model overrides, comma-separated, tried in order.
# HF_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
# HF_FALLBACK_MODELS=Qwen/Qwen3-VL-235B-A22B-Instruct
# NVIDIA_MODEL=google/gemma-4-31b-it
# If gemma doesn't respond on your account, moonshotai/kimi-k3 also accepts images (slower):
# NVIDIA_MODEL=moonshotai/kimi-k3,google/gemma-4-31b-it
