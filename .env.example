# Copy to .env.local and fill in. Never commit real keys.
# Set at least one provider key. Providers without a key are skipped.

# ---- free tiers (rate-limited, no card needed) ----
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter: https://openrouter.ai/settings/keys (":free" models; 50 requests/day, 1000 after a one-time $10 top-up)
OPENROUTER_API_KEY=

# ---- paid / credit-based ----
# Hugging Face router key (monthly included credits, then paid)
HF_TOKEN=
# NVIDIA NIM (OpenAI-compatible)
NVIDIA_API_KEY=

# Order in which providers are tried (default: huggingface,nvidia,gemini,groq,openrouter).
# Put the free tiers first to use them before any credits:
# PROVIDER_ORDER=gemini,groq,openrouter,huggingface,nvidia

# Optional model overrides, comma-separated, tried in order within each provider.
# GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash-lite
# GROQ_MODEL=qwen/qwen3.8-27b
# OPENROUTER_MODEL=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free
# HF_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
# HF_FALLBACK_MODELS=Qwen/Qwen3-VL-235B-A22B-Instruct
# NVIDIA_MODEL=google/gemma-4-31b-it
